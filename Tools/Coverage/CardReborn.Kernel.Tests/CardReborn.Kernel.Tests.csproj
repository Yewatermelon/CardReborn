<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the same EditMode test files Unity runs, against the off-Unity kernel library (M1-R2).
    The tests only use NUnit + Card.Core, so no Unity assembly is needed.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CardReborn.Kernel.Tests</AssemblyName>
    <RootNamespace>CardReborn.Kernel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Assets\_Project\7_Tests\EditMode\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardReborn.Kernel\CardReborn.Kernel.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
